{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!!**/.terraform",
			"!!**/.amplify-hosting",
			"!!**/.output",
			"!!**/.nitro",
			"!!**/.tanstack",
			"!!**/.turbo",
			"!!**/dist",
			"!!**/build",
			"!!**/coverage",
			"!!**/playwright-report",
			"!!**/test-results",
			"!!**/.lighthouseci",
			"!!apps/*/src/routeTree.gen.ts",
			"!!apps/carolyn/src/lib/generated-release",
			"!!apps/diloreto/src/content/genealogy/generated.json",
			"!apps/carolyn/tests/fixtures/contentful.json"
		]
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"react": {
								"importNames": ["default"],
								"message": "Use named imports from 'react' instead."
							}
						}
					}
				}
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}

{
	"name": "portfolio-website",
	"version": "2.0.0",
	"type": "module",
	"homepage": "https://pauldiloreto.com",
	"private": true,
	"author": "Paul DiLoreto <soodohh@pm.me>",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/soodoh/websites/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/soodoh/websites.git",
		"directory": "apps/paul"
	},
	"keywords": [
		"portfolio",
		"developer",
		"engineer",
		"tanstack",
		"react",
		"aws-amplify",
		"static-site"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun scripts/finalize-static-output.mjs",
		"start": "bun scripts/serve-static.mjs",
		"test:e2e": "./scripts/playwright-docker.sh --update-snapshots=none",
		"test:e2e:update": "./scripts/playwright-docker.sh --update-snapshots=all",
		"test:e2e:container": "playwright test",
		"test:e2e:local": "playwright test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
		"preview": "bun scripts/serve-static.mjs",
		"test:unit": "vitest run --config ../../vitest.config.mts --project paul --passWithNoTests",
		"test:static": "bun scripts/assert-static-output.mjs",
		"test:artifact": "bun run build && bun run test:static",
		"test:browser": "bun run test:e2e:static",
		"test:browser:update": "bun run build && PLAYWRIGHT_STATIC=1 PLAYWRIGHT_EXPECT_STATIC_404=1 ./scripts/playwright-docker.sh --update-snapshots=all",
		"test:browser:local": "bun run test:e2e:local -- --update-snapshots=none",
		"test:hosting": "bun scripts/hosting-smoke.mjs",
		"test:e2e:static": "bun run build && bun run test:e2e:static:prebuilt",
		"test:e2e:static:prebuilt": "PLAYWRIGHT_STATIC=1 PLAYWRIGHT_EXPECT_STATIC_404=1 ./scripts/playwright-docker.sh --update-snapshots=none",
		"lighthouse": "lhci autorun",
		"dev:workspace": "vite dev --port 3101",
		"ci:verify": "bun run lint && bun run typecheck && bun run test:unit && bun run lint:shell && bun run infra:lint && bun run build && bun run test:static && bun run test:e2e:static:prebuilt && bun run lighthouse",
		"lint:shell": "bash -c 'for script in scripts/*.sh; do bash -n \"$script\" || exit; done' && shellcheck scripts/*.sh",
		"infra:lint": "../../scripts/infra/validate-opentofu.sh apps/paul/infra/opentofu"
	},
	"dependencies": {
		"@fontsource/fjalla-one": "5.3.0",
		"@fontsource/geo": "5.3.0",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/react-router": "1.170.38",
		"@tanstack/react-start": "1.168.57",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "1.47.0",
		"radix-ui": "1.6.7",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-scroll-parallax": "3.5.0",
		"tailwind-merge": "3.7.0",
		"tailwindcss": "4.3.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@lhci/cli": "0.15.1",
		"@playwright/test": "1.63.0",
		"@types/node": "26.6.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"@websites/playwright-support": "workspace:*",
		"shadcn": "4.21.0",
		"tw-animate-css": "1.4.0",
		"typescript": "7.0.2",
		"vite": "8.3.0",
		"vitest": "5.0.1"
	}
}

FROM oven/bun:1.4.0 AS bun
FROM node:24.20.0-bookworm-slim AS node

FROM mcr.microsoft.com/playwright:v1.62.1-noble@sha256:dcc5531e97840b9b5e794f2814476b21571c5124a3fca2267d73041f56e7580e

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
COPY --from=node /usr/local/bin/node /usr/local/bin/node
RUN ln -s bun /usr/local/bin/bunx
WORKDIR /work
COPY package.json bun.lock bunfig.toml ./
COPY apps/carolyn/package.json apps/carolyn/package.json
COPY apps/diloreto/package.json apps/diloreto/package.json
COPY apps/paul/package.json apps/paul/package.json
COPY apps/sarabeth/package.json apps/sarabeth/package.json
RUN bun install --frozen-lockfile --ignore-scripts
COPY apps/carolyn apps/carolyn
WORKDIR /work/apps/carolyn
ENV CI=1
CMD ["bun", "x", "--no-install", "playwright", "test"]

FROM oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d AS bun
FROM node:26.13.1-bookworm-slim@sha256:5df79989ed685e09f0a98019db4cebfb22fb9df1a53c0161664a011f7ff6b0f1 AS node

FROM mcr.microsoft.com/playwright:v1.65.0-noble@sha256:6e3fb709361521eb27161606e6da6d2674e5e89fa16516cb37d6fdd91372273d

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
COPY --from=node /usr/local/bin/node /usr/local/bin/node
RUN ln -s bun /usr/local/bin/bunx
WORKDIR /work
COPY package.json bun.lock bunfig.toml ./
COPY biome.json tsconfig.base.json .gitignore ./
COPY vitest.config.mts ./
COPY apps/carolyn/package.json apps/carolyn/package.json
COPY apps/diloreto/package.json apps/diloreto/package.json
COPY apps/paul/package.json apps/paul/package.json
COPY apps/sarabeth/package.json apps/sarabeth/package.json
COPY packages/playwright-support/package.json packages/playwright-support/package.json
COPY packages/images/package.json packages/images/package.json
COPY packages/static-site/package.json packages/static-site/package.json
RUN bun install --frozen-lockfile --ignore-scripts
COPY renovate.json ./
COPY amplify.yml ./
COPY .github .github
COPY apps/sarabeth apps/sarabeth
COPY packages/playwright-support packages/playwright-support
COPY packages/images packages/images
COPY packages/static-site packages/static-site
COPY scripts/deploy scripts/deploy
WORKDIR /work/apps/sarabeth
ENV CI=1
ENTRYPOINT ["bash", "scripts/playwright-container.sh"]
CMD ["bun", "run", "test:ci:prebuilt"]

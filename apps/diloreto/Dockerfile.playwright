FROM oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d AS bun
FROM node:26.13.0-bookworm-slim@sha256:bc0a2afd3b74ce12222fc8bab99271e66257f021078f5f4a5d687a77d280c1d9 AS node

FROM mcr.microsoft.com/playwright:v1.64.1-noble@sha256:47b510dd9230bf0b9bfc9b20102241e577ea7a99334ab4c3ca19f19770e9b8ea

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
COPY --from=node /usr/local/bin/node /usr/local/bin/node
RUN ln -s bun /usr/local/bin/bunx
WORKDIR /work
COPY package.json bun.lock bunfig.toml ./
COPY apps/carolyn/package.json apps/carolyn/package.json
COPY apps/diloreto/package.json apps/diloreto/package.json
COPY apps/paul/package.json apps/paul/package.json
COPY apps/sarabeth/package.json apps/sarabeth/package.json
COPY packages/playwright-support/package.json packages/playwright-support/package.json
RUN bun install --frozen-lockfile --ignore-scripts
COPY apps/diloreto apps/diloreto
COPY packages/playwright-support packages/playwright-support
WORKDIR /work/apps/diloreto
RUN mkdir -p dist/client .playwright-output && chmod -R a+rX /work
RUN chmod -R a+rwX tests .playwright-output
ENV CI=1
ENV PLAYWRIGHT_IN_DOCKER=1
CMD ["bun", "x", "--no-install", "playwright", "test"]

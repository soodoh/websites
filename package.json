{
  "name": "websites",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soodoh/websites.git"
  },
  "bugs": {
    "url": "https://github.com/soodoh/websites/issues"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "24.21.0",
    "bun": "1.4.2"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev:workspace --concurrency=4",
    "lint": "turbo run lint --concurrency=1",
    "typecheck": "turbo run typecheck --concurrency=1",
    "test:unit": "bun run test:workspace && turbo run test:unit --concurrency=1",
    "ci:verify": "bun run test:workspace && bash scripts/ci/lint.sh && turbo run ci:verify --concurrency=1",
    "infra:validate": "bash scripts/infra/validate-opentofu.sh",
    "prepare": "test ! -e .git || lefthook install",
    "verify:sarabeth": "turbo run ci:verify --filter=sarabeth-studio --concurrency=1",
    "verify:paul": "turbo run ci:verify --filter=portfolio-website --concurrency=1",
    "verify:carolyn": "turbo run ci:verify --filter=carolyn-portfolio --concurrency=1",
    "verify:diloreto": "turbo run ci:verify --filter=diloreto-website --concurrency=1",
    "test:workspace": "vitest run --config vitest.config.mts --project workspace"
  },
  "devDependencies": {
    "turbo": "2.11.2",
    "vitest": "4.1.11",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "lefthook": "2.1.14"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
